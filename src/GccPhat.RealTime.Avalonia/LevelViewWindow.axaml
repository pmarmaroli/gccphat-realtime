<Window x:Class="GccPhat.RealTime.LevelViewWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        Title="Level view" Height="760" Width="1180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="14">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Margin="12,0,12,12" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
            <DockPanel>
                <TextBlock x:Name="SummaryText" Text="Waiting for live level data..."
                           Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Close" Width="90" Margin="12,0,0,0" Click="OnClose" />
            </DockPanel>
        </Border>

        <Grid Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="LEVEL VIEW" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"
                               FontWeight="Bold" FontSize="20" />
                    <TextBlock Text="Per-channel signal level (dBFS) over time."
                               Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

                    <!-- Channels -->
                    <TextBlock Classes="SectionHeader" Text="CHANNELS" Margin="0,12,0,8" />
                    <ItemsControl ItemsSource="{Binding ChannelMeters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="82" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas" FontSize="15"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Height="20" Minimum="0" Maximum="100"
                                                 Value="{Binding BarValue, Mode=OneWay}" Foreground="{Binding Activity, Converter={StaticResource ChannelActivityToBrush}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding LevelText}" FontFamily="Consolas" FontSize="14"
                                               Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Plot axes -->
                    <TextBlock Classes="SectionHeader" Text="PLOT AXES" Margin="0,16,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="X axis (time)" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                            <CheckBox Content="Auto (full)" IsChecked="{Binding LevelXAutoScale}" Margin="0,0,0,6" />
                            <Grid IsEnabled="{Binding CanEditLevelXRange}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="window (s)" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding LevelXWindowSeconds}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Y axis (level, dBFS)" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                            <CheckBox Content="Auto-scale" IsChecked="{Binding LevelYAutoScale}" Margin="0,0,0,6" />
                            <Grid IsEnabled="{Binding CanEditLevelYRange}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="min" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Margin="5,0" Text="{Binding LevelYMin}" />
                                <TextBlock Grid.Column="2" Text="max" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="3" Margin="5,0,0,0" Text="{Binding LevelYMax}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <sp:AvaPlot x:Name="LevelPlot" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
